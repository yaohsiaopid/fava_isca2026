Axiom "lw":
  forall microop "i", IsAnyRead i => 
  (AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, id_stage), (i, (0, mem_req)), "path", "black");
((i, issue), (i, load_unit_s1), "path", "black");
((i, scb_issue), (i, load_unit_s1), "path", "black");
((i, (0, mem_req)), (i, load_unit_s1), "path", "black");
((i, load_unit_s1), (i, load_unit_buff), "path", "black");
((i, load_unit_buff), (i, scb_commit), "path", "black")] /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, lsq) /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, store_unit_s1) /\ ~NodeExists(i, scb_comp) /\ ~NodeExists(i, stb_spec) /\ ~NodeExists(i, stb_com) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, id_stage), (i, (0, mem_req)), "path", "black");
((i, issue), (i, load_unit_s1), "path", "black");
((i, scb_issue), (i, load_unit_s1), "path", "black");
((i, (0, mem_req)), (i, load_unit_s1), "path", "black");
((i, load_unit_s1), (i, load_unit_buff), "path", "black");
((i, load_unit_buff), (i, scb_comp), "path", "black");
((i, scb_comp), (i, scb_commit), "path", "black")] /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, lsq) /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, store_unit_s1) /\ ~NodeExists(i, stb_spec) /\ ~NodeExists(i, stb_com) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, id_stage), (i, (0, mem_req)), "path", "black");
((i, id_stage), (i, load_unit_op_s2), "path", "black");
((i, issue), (i, load_unit_s1), "path", "black");
((i, scb_issue), (i, load_unit_s1), "path", "black");
((i, (0, mem_req)), (i, load_unit_s1), "path", "black");
((i, load_unit_op_s2), (i, load_unit_s1), "path", "black");
((i, load_unit_s1), (i, load_unit_buff), "path", "black");
((i, load_unit_buff), (i, scb_commit), "path", "black")] /\ ~NodeExists(i, lsq) /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, store_unit_s1) /\ ~NodeExists(i, scb_comp) /\ ~NodeExists(i, stb_spec) /\ ~NodeExists(i, stb_com) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, lsq), "path", "black");
((i, scb_issue), (i, lsq), "path", "black");
((i, lsq), (i, load_unit_op_s2), "path", "black");
((i, lsq), (i, (0, mem_req)), "path", "black");
((i, load_unit_op_s2), (i, load_unit_s1), "path", "black");
((i, (0, mem_req)), (i, load_unit_s1), "path", "black");
((i, load_unit_s1), (i, load_unit_buff), "path", "black");
((i, load_unit_buff), (i, scb_commit), "path", "black")] /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, store_unit_s1) /\ ~NodeExists(i, scb_comp) /\ ~NodeExists(i, stb_spec) /\ ~NodeExists(i, stb_com) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, lsq), "path", "black");
((i, scb_issue), (i, lsq), "path", "black");
((i, issue), (i, load_unit_op_s3), "path", "black");
((i, scb_issue), (i, load_unit_op_s3), "path", "black");
((i, load_unit_op_s3), (i, load_unit_op_s1), "path", "black");
((i, load_unit_op_s3), (i, (0, mem_req)), "path", "black");
((i, load_unit_op_s1), (i, load_unit_s1), "path", "black");
((i, (0, mem_req)), (i, load_unit_s1), "path", "black");
((i, load_unit_s1), (i, load_unit_buff), "path", "black");
((i, load_unit_buff), (i, scb_commit), "path", "black")] /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, store_unit_s1) /\ ~NodeExists(i, scb_comp) /\ ~NodeExists(i, stb_spec) /\ ~NodeExists(i, stb_com) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, lsq), "path", "black");
((i, scb_issue), (i, lsq), "path", "black");
((i, issue), (i, load_unit_op_s3), "path", "black");
((i, scb_issue), (i, load_unit_op_s3), "path", "black");
((i, lsq), (i, load_unit_op_s1), "path", "black");
((i, lsq), (i, (0, mem_req)), "path", "black");
((i, load_unit_op_s3), (i, load_unit_op_s1), "path", "black");
((i, load_unit_op_s3), (i, (0, mem_req)), "path", "black");
((i, load_unit_op_s1), (i, load_unit_s1), "path", "black");
((i, (0, mem_req)), (i, load_unit_s1), "path", "black");
((i, load_unit_s1), (i, load_unit_buff), "path", "black");
((i, load_unit_buff), (i, scb_comp), "path", "black");
((i, scb_comp), (i, scb_commit), "path", "black")] /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, store_unit_s1) /\ ~NodeExists(i, stb_spec) /\ ~NodeExists(i, stb_com) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, lsq), "path", "black");
((i, scb_issue), (i, lsq), "path", "black");
((i, lsq), (i, load_unit_op_s2), "path", "black");
((i, load_unit_op_s2), (i, load_unit_op_s3), "path", "black");
((i, load_unit_op_s3), (i, load_unit_op_s1), "path", "black");
((i, load_unit_op_s3), (i, (0, mem_req)), "path", "black");
((i, load_unit_op_s1), (i, load_unit_s1), "path", "black");
((i, (0, mem_req)), (i, load_unit_s1), "path", "black");
((i, load_unit_s1), (i, load_unit_buff), "path", "black");
((i, load_unit_buff), (i, scb_commit), "path", "black")] /\ ~NodeExists(i, store_unit_s1) /\ ~NodeExists(i, scb_comp) /\ ~NodeExists(i, stb_spec) /\ ~NodeExists(i, stb_com) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, lsq), "path", "black");
((i, scb_issue), (i, lsq), "path", "black");
((i, issue), (i, load_unit_op_s3), "path", "black");
((i, scb_issue), (i, load_unit_op_s3), "path", "black");
((i, load_unit_op_s3), (i, (0, mem_req)), "path", "black");
((i, lsq), (i, (0, mem_req)), "path", "black");
((i, load_unit_op_s3), (i, load_unit_op_s1), "path", "black");
((i, lsq), (i, load_unit_op_s1), "path", "black");
((i, (0, mem_req)), (i, load_unit_s1), "path", "black");
((i, load_unit_op_s1), (i, load_unit_s1), "path", "black");
((i, load_unit_s1), (i, load_unit_buff), "path", "black");
((i, load_unit_buff), (i, scb_commit), "path", "black")] /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, store_unit_s1) /\ ~NodeExists(i, scb_comp) /\ ~NodeExists(i, stb_spec) /\ ~NodeExists(i, stb_com) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)).

Axiom "sw":
  forall microop "i", IsAnyWrite i => 
  (AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, store_unit_s1), "path", "black");
((i, scb_issue), (i, store_unit_s1), "path", "black");
((i, store_unit_s1), (i, stb_spec), "path", "black");
((i, store_unit_s1), (i, scb_commit), "path", "black");
((i, scb_commit), (i, stb_com), "path", "black");
((i, stb_spec), (i, stb_com), "path", "black");
((i, stb_com), (i, (0, mem_req)), "path", "black")] /\ ~NodeExists(i, load_unit_s1) /\ ~NodeExists(i, load_unit_buff) /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, lsq) /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, scb_comp) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, store_unit_s1), "path", "black");
((i, scb_issue), (i, store_unit_s1), "path", "black");
((i, store_unit_s1), (i, stb_spec), "path", "black");
((i, stb_spec), (i, scb_commit), "path", "black");
((i, scb_commit), (i, stb_com), "path", "black");
((i, stb_spec), (i, stb_com), "path", "black");
((i, scb_commit), (i, (0, mem_req)), "path", "black");
((i, stb_com), (i, (0, mem_req)), "path", "black")] /\ ~NodeExists(i, load_unit_s1) /\ ~NodeExists(i, load_unit_buff) /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, lsq) /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, scb_comp) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, store_unit_s1), "path", "black");
((i, scb_issue), (i, store_unit_s1), "path", "black");
((i, store_unit_s1), (i, stb_spec), "path", "black");
((i, store_unit_s1), (i, scb_comp), "path", "black");
((i, scb_comp), (i, scb_commit), "path", "black");
((i, stb_spec), (i, scb_commit), "path", "black");
((i, scb_commit), (i, stb_com), "path", "black");
((i, stb_spec), (i, stb_com), "path", "black");
((i, scb_commit), (i, (0, mem_req)), "path", "black");
((i, stb_spec), (i, (0, mem_req)), "path", "black")] /\ ~NodeExists(i, load_unit_s1) /\ ~NodeExists(i, load_unit_buff) /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, lsq) /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, lsq), "path", "black");
((i, scb_issue), (i, lsq), "path", "black");
((i, lsq), (i, store_unit_s1), "path", "black");
((i, store_unit_s1), (i, stb_spec), "path", "black");
((i, store_unit_s1), (i, scb_comp), "path", "black");
((i, scb_comp), (i, scb_commit), "path", "black");
((i, stb_spec), (i, scb_commit), "path", "black");
((i, scb_commit), (i, stb_com), "path", "black");
((i, stb_spec), (i, stb_com), "path", "black");
((i, scb_commit), (i, (0, mem_req)), "path", "black");
((i, stb_spec), (i, (0, mem_req)), "path", "black")] /\ ~NodeExists(i, load_unit_s1) /\ ~NodeExists(i, load_unit_buff) /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, store_unit_s3) /\ ~NodeExists(i, csr_buff)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, lsq), "path", "black");
((i, scb_issue), (i, lsq), "path", "black");
((i, issue), (i, store_unit_s3), "path", "black");
((i, scb_issue), (i, store_unit_s3), "path", "black");
((i, lsq), (i, store_unit_s1), "path", "black");
((i, store_unit_s3), (i, store_unit_s1), "path", "black");
((i, store_unit_s1), (i, stb_spec), "path", "black");
((i, store_unit_s1), (i, scb_comp), "path", "black");
((i, scb_comp), (i, scb_commit), "path", "black");
((i, stb_spec), (i, scb_commit), "path", "black");
((i, scb_commit), (i, stb_com), "path", "black");
((i, stb_spec), (i, stb_com), "path", "black");
((i, scb_commit), (i, (0, mem_req)), "path", "black");
((i, stb_spec), (i, (0, mem_req)), "path", "black")] /\ ~NodeExists(i, load_unit_s1) /\ ~NodeExists(i, load_unit_buff) /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, csr_buff)).

Axiom "fence":
  forall microop "i", IsAnyFence i => 
  (AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, csr_buff), "path", "black");
((i, scb_issue), (i, csr_buff), "path", "black");
((i, csr_buff), (i, scb_commit), "path", "black")] /\ ~NodeExists(i, mem_req) /\ ~NodeExists(i, load_unit_s1) /\ ~NodeExists(i, load_unit_buff) /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, lsq) /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, store_unit_s1) /\ ~NodeExists(i, scb_comp) /\ ~NodeExists(i, stb_spec) /\ ~NodeExists(i, stb_com) /\ ~NodeExists(i, store_unit_s3)) \/ 
(AddEdges [((i, id_stage), (i, issue), "path", "black");
((i, id_stage), (i, scb_issue), "path", "black");
((i, issue), (i, csr_buff), "path", "black");
((i, scb_issue), (i, csr_buff), "path", "black");
((i, issue), (i, scb_comp), "path", "black");
((i, scb_issue), (i, scb_comp), "path", "black");
((i, scb_comp), (i, scb_commit), "path", "black")] /\ ~NodeExists(i, mem_req) /\ ~NodeExists(i, load_unit_s1) /\ ~NodeExists(i, load_unit_buff) /\ ~NodeExists(i, load_unit_op_s2) /\ ~NodeExists(i, lsq) /\ ~NodeExists(i, load_unit_op_s3) /\ ~NodeExists(i, load_unit_op_s1) /\ ~NodeExists(i, store_unit_s1) /\ ~NodeExists(i, stb_spec) /\ ~NodeExists(i, stb_com) /\ ~NodeExists(i, store_unit_s3)).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Inter HBI Data
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% xDataDepMisc/same_addr_s1.sv  
Axiom "data_dep_1_atomic_mem": 
forall microops "i1", forall microops "i2", 
(IsAnyWrite i1 /\ IsAnyRead i2 /\ SameData i1 i2 /\ SamePhysicalAddress i1 i2) => 
AddEdge ((i1, (0, mem_req)), (i2, (0, mem_req)), "rf", "green").

Axiom "data_dep_2_atomic_mem": 
forall microops "i1", forall microop "i2",
(IsAnyRead i1 /\ DataFromInitialStateAtPA i1 /\ 
IsAnyWrite i2 /\ SamePhysicalAddress i1 i2) => 
AddEdge ((i1, (0, mem_req)), (i2, (0, mem_req)), "fr", "green").

Axiom "data_dep_2_noninterfere_for_atomic_mem":
forall microops "i1", forall microops "i2", 
(IsAnyWrite i1 /\ IsAnyRead i2 /\ SameData i1 i2 /\ SamePhysicalAddress i1 i2) => 
~(exists microop "j", IsAnyWrite j /\ SamePhysicalAddress j i1 /\
EdgeExists ((i1, (0, mem_req)), (j, (0, mem_req)), "inter", "magenta") /\ 
EdgeExists ((j, (0, mem_req)), (i2, (0, mem_req)), "inter", "magenta")).

%%%%%%%%%%%%
% TODO
Axiom "atomic_mem":
forall microops "i1", forall microops "i2", 
SamePhysicalAddress i1 i2 /\ 
ProgramOrder i1 i2 =>
NodeExists (i1, (0, mem_req)) /\ NodeExists (i2, (0, mem_req)) =>
EdgeExists ((i1, (0, mem_req)), (i2, (0, mem_req)), "inter", "magenta").
Axiom "coh_fin":
forall microop "w", forall microop "w'",
(IsAnyWrite w /\ IsAnyWrite w' /\ 
SamePhysicalAddress w w' /\  ~SameMicroop w w' /\ DataFromFinalStateAtPA w') =>  
  AddEdge ((w, (0, mem_req)), (w', (0, mem_req)), "final", "red").
