%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Inter HBI Structural (undetermined)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Exiting the STB in order
% ../fv/xStructural/SW_SW/out/9.sv
Axiom "SW_SW_mem_req":
forall microops "i1", forall microops "i2", 
(IsAnyWrite i1 /\ IsAnyWrite i2 /\ ProgramOrder i1 i2) => 
EdgeExists ((i1, (0, mem_req)), (i2, (0, mem_req)), "inter_undet", "red").

% ../fv/xDataDepMisc/same_addr_dep.{sv,csv}
Axiom "SW_LW_same_addr":
forall microops "i1", forall microops "i2", 
(IsAnyWrite i1 /\ IsAnyRead i2 /\ SamePhysicalAddress i1 i2 /\ ProgramOrder i1 i2) => 
EdgeExists ((i1, (0, mem_req)), (i2, (0, mem_req)), "inter_undet", "red").

% waits for drain, which we is the complete of store, i.e., (0, mem_req)
% ../fv/xDataDepMisc/sw_fence_2.{sv,csv}
Axiom "SW_FENCE":
forall microops "i1", forall microops "i2", 
(IsAnyWrite i1 /\ IsAnyFence i2 /\ ProgramOrder i1 i2) => 
EdgeExists ((i1, (0, mem_req)), (i2, scb_commit), "inter_undet", "red").


% Only when FENCE is at the head of scoreboard does it broadcast to flush the
% dcache but in the core there is not such guarding in wiating for fence to
% finish 
% as in the decoder.sv
% // Currently implemented as a whole DCache flush boldly ignoring other things      

% ../fv/xDataDepMisc/FENCE_scb_commit_LW_mem_req_COMMITTED_LW.{sv, csv}
Axiom "FENCE_LW":
forall microops "i1", forall microops "i2", 
(IsAnyFence i1 /\ IsAnyRead i2 /\ ProgramOrder i1 i2) => 
EdgeExists ((i1, scb_commit), (i2, (0, mem_req)), "inter_exists", "red").

% ../fv/xStructural/LW_SW/out/6.sv
Axiom "LW_SW_mem_req":
forall microops "i1", forall microops "i2", 
(IsAnyRead i1 /\ IsAnyWrite i2 /\ ProgramOrder i1 i2) => 
EdgeExists ((i1, (0, mem_req)), (i2, (0, mem_req)), "inter_undet", "red").

% ../fv/xStructural/LW_LW/out/9.sv
Axiom "LW_LW_mem_req":
forall microops "i1", forall microops "i2", 
(IsAnyRead i1 /\ IsAnyRead i2 /\ ProgramOrder i1 i2) => 
EdgeExists ((i1, (0, mem_req)), (i2, (0, mem_req)), "inter_undet", "red").




%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Proven Structural Dependencies
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

Axiom "LW_issue_LW_issue": forall microops "i1", forall microops "i2", 
(OnCore c i1 /\ OnCore c i2 /\ ProgramOrder i1 i2 /\ IsAnyRead i1 /\ IsAnyRead i2) => 
NodeExists(i1, issue) /\ NodeExists (i2, issue) =>
AddEdge ((i1, issue), (i2, issue), "PO", "blue").
Axiom "LW_id_stage_LW_id_stage": forall microops "i1", forall microops "i2", 
(OnCore c i1 /\ OnCore c i2 /\ ProgramOrder i1 i2 /\ IsAnyRead i1 /\ IsAnyRead i2) => 
NodeExists(i1, id_stage) /\ NodeExists (i2, id_stage) =>
AddEdge ((i1, id_stage), (i2, id_stage), "PO", "blue").
Axiom "LW_lsq_LW_lsq": forall microops "i1", forall microops "i2", 
(OnCore c i1 /\ OnCore c i2 /\ ProgramOrder i1 i2 /\ IsAnyRead i1 /\ IsAnyRead i2) => 
NodeExists(i1, lsq) /\ NodeExists (i2, lsq) =>
AddEdge ((i1, lsq), (i2, lsq), "PO", "blue").
Axiom "LW_issue_SW_issue": forall microops "i1", forall microops "i2", 
(OnCore c i1 /\ OnCore c i2 /\ ProgramOrder i1 i2 /\ IsAnyRead i1 /\ IsAnyWrite i2) => 
NodeExists(i1, issue) /\ NodeExists (i2, issue) =>
AddEdge ((i1, issue), (i2, issue), "PO", "blue").
Axiom "LW_id_stage_SW_id_stage": forall microops "i1", forall microops "i2", 
(OnCore c i1 /\ OnCore c i2 /\ ProgramOrder i1 i2 /\ IsAnyRead i1 /\ IsAnyWrite i2) => 
NodeExists(i1, id_stage) /\ NodeExists (i2, id_stage) =>
AddEdge ((i1, id_stage), (i2, id_stage), "PO", "blue").
Axiom "LW_lsq_SW_lsq": forall microops "i1", forall microops "i2", 
(OnCore c i1 /\ OnCore c i2 /\ ProgramOrder i1 i2 /\ IsAnyRead i1 /\ IsAnyWrite i2) => 
NodeExists(i1, lsq) /\ NodeExists (i2, lsq) =>
AddEdge ((i1, lsq), (i2, lsq), "PO", "blue").
